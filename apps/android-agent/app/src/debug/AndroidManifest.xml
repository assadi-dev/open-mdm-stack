<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug overlay: no longer marks the build as testOnly, so the debug APK installs
  like any other (`adb install -r app-debug.apk`, no `-t`). The flip side: a Device
  Owner provisioned with a debug build can no longer be removed with
  `adb shell dpm remove-active-admin ...`, only a factory reset (or the agent
  itself) removes it. Use the buildTestOnly variant for a removable Device Owner.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

</manifest>
