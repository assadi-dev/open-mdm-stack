{
  "name": "repo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "docker:up": "docker compose --env-file dependencies/.env -f dependencies/compose.yml  up -d --build",
    "docker:down": "docker compose --env-file dependencies/.env -f dependencies/compose.yml down -v",
    "docker:logs": "docker compose --env-file dependencies/.env -f dependencies/compose.ymllogs -f"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.18",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.10.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}